+export async function pulseCsrfToken(): Promise<string | undefined> {
+  try {
+    const response = await fetchWithTimeout(
+      "/api/auth/status",
+      { credentials: "include", headers: { Accept: "application/json" } },
+      DEFAULT_API_TIMEOUT_MS,
+    );
+    if (!response.ok) return undefined;
+    const status = (await response.json()) as { csrf_token?: unknown };
+    const token = status.csrf_token;
+    return typeof token === "string" && /^[a-f0-9]{64}$/i.test(token) ? token : undefined;
+  } catch {
+    // Native Komari has no Pulse authentication endpoint.
+    return undefined;
+  }
+}
