+
+it("retains load and traffic history when optional hardware metrics are unavailable", () => {
+  const sample = LoadRecordSchema.parse({
+    time: "2026-09-26T00:00:00Z", cpu: 25, ram: 1024,
+    net_total_up: 3000, net_total_down: 4000,
+    gpu: null, temp: null, process: null, connections: null, connections_udp: null,
+  });
+  expect(sample.cpu).toBe(25);
+  expect(sample.net_total_up).toBe(3000);
+  expect(sample.net_total_down).toBe(4000);
+});
diff --git a/src/services/__tests__/rpc2Client.pulse.test.ts b/src/services/__tests__/rpc2Client.pulse.test.ts
new file mode 100644
index 0000000..e76143a
--- /dev/null
+++ b/src/services/__tests__/rpc2Client.pulse.test.ts
@@ -0,0 +1,22 @@
+import { afterEach, expect, it, vi } from "vitest";
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+  vi.unstubAllEnvs();
+  vi.resetModules();
+});
+
+it("uses HTTP without attempting WebSocket in the Pulse package", async () => {
+  vi.stubEnv("VITE_PULSE_HTTP_RPC", "true");
+  const ws = vi.fn();
+  vi.stubGlobal("WebSocket", ws);
+  const fetchMock = vi.fn().mockResolvedValue(new Response(JSON.stringify({
+    jsonrpc: "2.0", id: 1, result: { online: true },
+  })));
+  vi.stubGlobal("fetch", fetchMock);
+  const { getRpc2Client } = await import("@/services/rpc2Client");
+  const client = getRpc2Client();
+  await expect(client.call("common:getNodesLatestStatus")).resolves.toEqual({ online: true });
+  expect(ws).not.toHaveBeenCalled();
+  expect(fetchMock).toHaveBeenCalledTimes(1);
+});
