# Senulun Service. Enrollment tokens are created with the local admin CLI.
SENULUN_LISTEN=127.0.0.1:8080
SENULUN_DATABASE_PATH=senulun.db
# The derived sibling senulun.metrics.db must be persisted and backed up with senulun.db.
SENULUN_RETENTION_DAYS=7
SENULUN_OFFLINE_AFTER_SECONDS=90
SENULUN_MAX_NODES=100
# Per-file limit for BOTH databases: default total allowance is 4 GiB, excluding WAL/backups.
SENULUN_MAX_DATABASE_BYTES=2147483648
# Exact browser origin; HTTPS is required except for local loopback development.
SENULUN_PUBLIC_URL=http://127.0.0.1:8080
# GitHub login is off unless all three settings are explicitly configured.
# SENULUN_GITHUB_CLIENT_ID=
# SENULUN_GITHUB_CLIENT_SECRET_FILE=./github-client-secret
# SENULUN_GITHUB_ALLOWED_USER_ID=
# Required only for a deliberate non-loopback bind. Terminate TLS in front.
SENULUN_ALLOW_PUBLIC_LISTEN=false

# Senulun Agent. Supply exactly one token source only for first enrollment.
SENULUN_SERVICE_URL=http://127.0.0.1:8080
SENULUN_NODE_NAME=example-node
# Manual country code (e.g. US, SG), or empty for default automatic discovery.
SENULUN_NODE_REGION=
# Default GeoJS sees public egress IP and Agent version, not credentials/metrics.
# Set disabled to opt out, or ipinfo to change provider. Manual region wins.
SENULUN_GEOIP_PROVIDER=geojs
SENULUN_NODE_GROUP=default
SENULUN_NODE_VIRTUALIZATION=
SENULUN_INTERVAL_SECONDS=3
SENULUN_CREDENTIALS_PATH=./agent-credentials.json
# Preferred for production; the file must be mode 0600 and can be removed after enrollment.
SENULUN_ENROLLMENT_TOKEN_FILE=./enrollment-token
# SENULUN_ENROLLMENT_TOKEN=replace-with-the-short-lived-token
# Optional exact comma-separated filters:
# SENULUN_DISK_MOUNT_POINTS=/,/data
# SENULUN_NETWORK_INTERFACES=eth0
