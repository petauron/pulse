# Pulse Service. Enrollment tokens are created with the local admin CLI.
PULSE_LISTEN=127.0.0.1:8080
PULSE_DATABASE_PATH=pulse.db
PULSE_RETENTION_DAYS=7
PULSE_OFFLINE_AFTER_SECONDS=90
PULSE_MAX_NODES=100
PULSE_MAX_DATABASE_BYTES=2147483648
# Required only for a deliberate non-loopback bind. Put authenticated TLS in front.
PULSE_ALLOW_PUBLIC_LISTEN=false

# Pulse Agent. Supply exactly one token source only for first enrollment.
PULSE_SERVICE_URL=http://127.0.0.1:8080
PULSE_NODE_NAME=example-node
PULSE_NODE_REGION=SG
PULSE_NODE_GROUP=default
PULSE_NODE_VIRTUALIZATION=
PULSE_INTERVAL_SECONDS=30
PULSE_CREDENTIALS_PATH=./agent-credentials.json
# Preferred for production; the file must be mode 0600 and can be removed after enrollment.
PULSE_ENROLLMENT_TOKEN_FILE=./enrollment-token
# PULSE_ENROLLMENT_TOKEN=replace-with-the-short-lived-token
# Optional exact comma-separated filters:
# PULSE_DISK_MOUNT_POINTS=/,/data
# PULSE_NETWORK_INTERFACES=eth0
