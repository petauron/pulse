# Pulse Service. Enrollment tokens are created with the local admin CLI.
PULSE_LISTEN=127.0.0.1:8080
PULSE_DATABASE_PATH=pulse.db
# The derived sibling pulse.metrics.db must be persisted and backed up with pulse.db.
PULSE_RETENTION_DAYS=7
PULSE_OFFLINE_AFTER_SECONDS=90
PULSE_MAX_NODES=100
# Per-file limit for BOTH databases: default total allowance is 4 GiB, excluding WAL/backups.
PULSE_MAX_DATABASE_BYTES=2147483648
# Exact browser origin; HTTPS is required except for local loopback development.
PULSE_PUBLIC_URL=http://127.0.0.1:8080
# Private file containing at least 32 random characters. Required for first admin setup.
PULSE_SETUP_TOKEN_FILE=./setup-token
# GitHub login is off unless all three settings are explicitly configured.
# PULSE_GITHUB_CLIENT_ID=
# PULSE_GITHUB_CLIENT_SECRET_FILE=./github-client-secret
# PULSE_GITHUB_ALLOWED_USER_ID=
# Required only for a deliberate non-loopback bind. Terminate TLS in front.
PULSE_ALLOW_PUBLIC_LISTEN=false

# Pulse Agent. Supply exactly one token source only for first enrollment.
PULSE_SERVICE_URL=http://127.0.0.1:8080
PULSE_NODE_NAME=example-node
# Manual country code (e.g. US, SG), or empty for default automatic discovery.
PULSE_NODE_REGION=
# Default GeoJS sees public egress IP and Agent version, not credentials/metrics.
# Set disabled to opt out, or ipinfo to change provider. Manual region wins.
PULSE_GEOIP_PROVIDER=geojs
PULSE_NODE_GROUP=default
PULSE_NODE_VIRTUALIZATION=
PULSE_INTERVAL_SECONDS=3
PULSE_CREDENTIALS_PATH=./agent-credentials.json
# Preferred for production; the file must be mode 0600 and can be removed after enrollment.
PULSE_ENROLLMENT_TOKEN_FILE=./enrollment-token
# PULSE_ENROLLMENT_TOKEN=replace-with-the-short-lived-token
# Optional exact comma-separated filters:
# PULSE_DISK_MOUNT_POINTS=/,/data
# PULSE_NETWORK_INTERFACES=eth0
