[Unit]
Description=Pulse monitoring service
Documentation=https://github.com/petauron/pulse
After=network.target

[Service]
Type=simple
User=pulse
Group=pulse
EnvironmentFile=/etc/pulse/service.env
ExecStart=/usr/local/bin/pulse-service serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
StateDirectory=pulse
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/pulse
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
