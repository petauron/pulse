PULSE_LISTEN=127.0.0.1:8080
PULSE_DATABASE_PATH=/var/lib/pulse/pulse.db
# Persist the derived sibling pulse.metrics.db together with pulse.db.
PULSE_RETENTION_DAYS=7
PULSE_OFFLINE_AFTER_SECONDS=90
PULSE_MAX_NODES=100
# Per-file bound for each database, excluding WAL files and backups.
PULSE_MAX_DATABASE_BYTES=2147483648
# Exact browser-facing HTTPS origin, also used for OAuth callback and CSRF checks.
PULSE_PUBLIC_URL=https://pulse.example.com
# Private mode-0600 file readable by the Service. Remove this setting and file after setup.
PULSE_SETUP_TOKEN_FILE=/etc/pulse/setup-token
# Optional GitHub OAuth: configure all three together; allow only this numeric account ID.
# PULSE_GITHUB_CLIENT_ID=
# PULSE_GITHUB_CLIENT_SECRET_FILE=/etc/pulse/github-client-secret
# PULSE_GITHUB_ALLOWED_USER_ID=
# Set true only when TLS is terminated by a reverse proxy or a private network is enforced.
PULSE_ALLOW_PUBLIC_LISTEN=false
