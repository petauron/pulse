SENULUN_LISTEN=127.0.0.1:8080
SENULUN_DATABASE_PATH=/var/lib/senulun/store/senulun.db
# Persist the derived sibling senulun.metrics.db together with senulun.db.
SENULUN_RETENTION_DAYS=7
SENULUN_OFFLINE_AFTER_SECONDS=90
SENULUN_MAX_NODES=100
# Per-file bound for each database, excluding WAL files and backups.
SENULUN_MAX_DATABASE_BYTES=2147483648
# Exact browser-facing HTTPS origin, also used for OAuth callback and CSRF checks.
SENULUN_PUBLIC_URL=https://senulun.example.com
# Optional GitHub OAuth: configure all three together; allow only this numeric account ID.
# SENULUN_GITHUB_CLIENT_ID=
# SENULUN_GITHUB_CLIENT_SECRET_FILE=/etc/senulun/github-client-secret
# SENULUN_GITHUB_ALLOWED_USER_ID=
# Set true only when TLS is terminated by a reverse proxy or a private network is enforced.
SENULUN_ALLOW_PUBLIC_LISTEN=false
