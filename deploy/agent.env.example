PULSE_SERVICE_URL=https://pulse.example.com/
PULSE_NODE_NAME=example-node
PULSE_NODE_REGION=SG
PULSE_NODE_GROUP=default
PULSE_NODE_VIRTUALIZATION=
PULSE_INTERVAL_SECONDS=30
PULSE_CREDENTIALS_PATH=/var/lib/pulse-agent/agent-credentials.json
# Create this mode-0600 file only for first enrollment, then remove it.
PULSE_ENROLLMENT_TOKEN_FILE=/etc/pulse/agent-enrollment-token
# Optional exact comma-separated filters. Leave unset to include deduplicated disks
# and every non-loopback network interface.
# PULSE_DISK_MOUNT_POINTS=/,/data
# PULSE_NETWORK_INTERFACES=eth0
